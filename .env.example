# Copy to .env.local and adjust. Never commit real credentials.

# Public origin of the deployment. Used for dynamic short links (/r/CODE), metadata,
# the sitemap and robots.txt. Required in production so printed codes use your real domain.
APP_URL=http://localhost:3000

# MongoDB (e.g. Atlas) for dynamic QR codes and uploaded-video metadata.
# Static QR generation never needs it. Collections and indexes are created automatically.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB=qr_studio

# ---------------------------------------------------------------------------
# Video uploads (optional). Uploaded videos are always served through a dynamic code.
#   local    – files on this server's disk (development / single server with a persistent volume)
#   s3       – any S3-compatible bucket (Cloudflare R2, AWS S3, MinIO, Backblaze B2…); required on serverless
#   disabled – link-only video QR codes
# Default: local in development, disabled in production.
VIDEO_UPLOAD_DRIVER=local
VIDEO_MAX_UPLOAD_MB=100
# Total bytes of all stored videos before new uploads are refused.
VIDEO_STORAGE_QUOTA_GB=5
RATE_LIMIT_UPLOADS_PER_HOUR=10
# local driver:
VIDEO_STORAGE_DIR=storage/videos
# s3 driver (endpoint must also be set at build time so the CSP allows browser uploads):
VIDEO_S3_ENDPOINT=
VIDEO_S3_BUCKET=
VIDEO_S3_REGION=auto
VIDEO_S3_ACCESS_KEY_ID=
VIDEO_S3_SECRET_ACCESS_KEY=

# Optional: enables POST /api/admin/takedown for abuse reports (at least 32 random characters).
ADMIN_TOKEN=

# Optional: comma-separated hostnames that dynamic codes may not redirect to.
BLOCKED_DESTINATION_HOSTS=

# Optional: per-IP limits for the dynamic QR API (per 10 minutes, per server instance).
RATE_LIMIT_CREATE_PER_10_MIN=30
RATE_LIMIT_MANAGE_PER_10_MIN=300
