# Copy to .env.local (or add in Vercel → Settings → Environment Variables).
# Never commit real credentials.

# ---------------------------------------------------------------------------
# REQUIRED for dynamic QR codes and video uploads — everything is stored in MongoDB.
# (Static QR generation works without it.)
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"

# ---------------------------------------------------------------------------
# Optional — sensible defaults are used when these are left out.

# Public site address. On Vercel the production domain is detected automatically;
# set this when you use a custom domain (before printing dynamic codes).
# APP_URL=https://your-domain.com

# Database name (default: qr_studio).
# MONGODB_DB=qr_studio

# Video uploads are stored in MongoDB by default (GridFS layout, uploaded in 4 MiB pieces).
# Defaults: 50 MB per file, 0.4 GB total — sized for Atlas M0's 512 MB.
# VIDEO_MAX_UPLOAD_MB=50
# VIDEO_STORAGE_QUOTA_GB=0.4
# Alternatives: local (disk), s3 (Cloudflare R2/AWS S3/MinIO) or disabled.
# VIDEO_UPLOAD_DRIVER=mongodb
# local driver:  VIDEO_STORAGE_DIR=storage/videos
# s3 driver:     VIDEO_S3_ENDPOINT=  VIDEO_S3_BUCKET=  VIDEO_S3_REGION=auto
#                VIDEO_S3_ACCESS_KEY_ID=  VIDEO_S3_SECRET_ACCESS_KEY=

# Enables POST /api/admin/takedown for abuse reports (at least 32 random characters).
# ADMIN_TOKEN=

# Hostnames dynamic codes may not redirect to (comma-separated).
# BLOCKED_DESTINATION_HOSTS=

# Per-IP limits (per server instance).
# RATE_LIMIT_CREATE_PER_10_MIN=30
# RATE_LIMIT_MANAGE_PER_10_MIN=300
# RATE_LIMIT_UPLOADS_PER_HOUR=10
